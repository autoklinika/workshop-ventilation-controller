# Optional remote synchronization configuration.
#
# Local telemetry capture to /srv/wvc-data/workshop-ventilation/telemetry.sqlite3
# works even when this file is absent or WVC_AI_BRIDGE_URL is not set.
# The local database itself requires the mounted NVMe data tier.
#
# When a logical AI Bridge / Data Gateway endpoint is available, set e.g.:
# WVC_AI_BRIDGE_URL=http://192.168.1.55:8080
#
# The endpoint is intentionally logical: CM5 must not depend on whether the
# central archive currently lives on the AI Server or later on the NAS.
WVC_TELEMETRY_SOURCE_ID=workshop-ventilation-cm5-01
