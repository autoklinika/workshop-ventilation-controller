# Workshop Ventilation CM5 weather provider
# Keep site coordinates in /etc/default/wvc-weather on the CM5; do not commit private site data.
WVC_WEATHER_LATITUDE=
WVC_WEATHER_LONGITUDE=
WVC_WEATHER_LABEL=Warsztat
WVC_WEATHER_USER_AGENT=
WVC_WEATHER_POLL_INTERVAL=3600
WVC_WEATHER_HTTP_TIMEOUT=5
WVC_WEATHER_CACHE=/srv/wvc-data/workshop-ventilation/weather.json
