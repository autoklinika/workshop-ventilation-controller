# Workshop Ventilation Web UI
WVC_WEB_HOST=0.0.0.0
WVC_WEB_PORT=8088
WVC_CORE_SOCKET=/run/workshop-ventilation/ventilation-core.sock
# AERO physical confirmation can legitimately take up to 60 s.
WVC_WEB_CORE_TIMEOUT=70

# Display mapping only. Change these values if physical slave-to-room assignment differs.
WVC_WEB_ZONE1_NAME=Mycie i wygrzewanie ECU
WVC_WEB_ZONE1_SENSOR_ADDRESS=1
WVC_WEB_ZONE2_NAME=Pomieszczenie lutowania
WVC_WEB_ZONE2_SENSOR_ADDRESS=2

# Read-only historical/cache data lives on the NVMe data tier.
WVC_WEB_TELEMETRY_DATABASE=/srv/wvc-data/workshop-ventilation/telemetry.sqlite3
WVC_WEB_ALERT_DATABASE=/srv/wvc-data/workshop-ventilation/alerts.sqlite3
WVC_WEB_WEATHER_SNAPSHOT=/srv/wvc-data/workshop-ventilation/weather.json
WVC_WEB_AI_ADVISORY_CACHE=/srv/wvc-data/workshop-ventilation/ai-advisory.json
