table inet wvc_sensor_service {
    chain input {
        type filter hook input priority 0; policy accept;

        # DHCP clients of the private service network.
        iifname "wlan0" udp sport 68 udp dport 67 accept

        # Minimal link diagnostics to the CM5.
        iifname "wlan0" ip protocol icmp icmp type echo-request accept

        # Stage 1 service channel: authenticated, node-to-CM5 UDP heartbeat.
        # No return application port and no node listener are opened.
        iifname "wlan0" ip daddr 10.55.0.1 udp dport 45551 accept

        # SSH, APIs and every other local CM5 service remain unavailable from wlan0.
        iifname "wlan0" drop
    }

    chain forward {
        type filter hook forward priority 0; policy accept;

        # Nodes cannot use the CM5 as a router to Ethernet or any other interface.
        iifname "wlan0" drop
        oifname "wlan0" drop
    }
}
