[Unit]
Description=WVC private DHCP for KAmod sensor nodes
After=NetworkManager.service wvc-sensor-firewall.service
Wants=NetworkManager.service
Requires=wvc-sensor-firewall.service

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do ip -4 addr show dev wlan0 | grep -q "10.55.0.1/24" && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/dnsmasq.d/wvc-sensor-service.conf --pid-file=
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
