[Unit]
Description=Workshop Ventilation Core
After=local-fs.target

[Service]
Type=simple
User=wentylacja
Group=wentylacja
SupplementaryGroups=i2c dialout
WorkingDirectory=/home/wentylacja/workshop-ventilation-controller
Environment=PYTHONPATH=/home/wentylacja/workshop-ventilation-controller/src
Environment=PYTHONUNBUFFERED=1
RuntimeDirectory=workshop-ventilation
RuntimeDirectoryMode=0770
StateDirectory=workshop-ventilation
StateDirectoryMode=0770
UMask=0007
ExecStart=/usr/bin/python3 -m ventilation_core.main --socket /run/workshop-ventilation/ventilation-core.sock --alerts-db /var/lib/workshop-ventilation/alerts.sqlite3 --automation-db /var/lib/workshop-ventilation/automation.sqlite3 --sensor-port /dev/ttyAMA0 --sensor-addresses 1,2 --sensor-baud 19200 --sensor-timeout 0.5 --sensor-poll-interval 1.0 --sensor-inter-node-delay 0.010 --sensor-reconnect-delay 1.0 --aero-port /dev/ttyAMA4 --aero-address 44 --aero-baud 9600 --aero-timeout 0.5 --aero-poll-interval 2.0 --aero-inter-register-delay 0.050 --aero-reconnect-delay 1.0 --enable-supply-tacho --enable-extract-tacho --tacho-chip /dev/gpiochip0 --supply-tacho-line GPIO17 --extract-tacho-line GPIO27 --tacho-timeout 0.25 --tacho-averaging-periods 6 --log-level INFO
Restart=on-failure
RestartSec=2
TimeoutStopSec=20
KillSignal=SIGTERM
KillMode=mixed
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
