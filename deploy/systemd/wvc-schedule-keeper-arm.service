[Unit]
Description=WVC refresh RTC before manual CM5 shutdown
After=ventilation-core.service
Requires=ventilation-core.service
ConditionPathExists=/sys/class/rtc/rtc0/wakealarm

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/local/libexec/wvc-schedule-keeper.py arm
TimeoutStartSec=30
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX
