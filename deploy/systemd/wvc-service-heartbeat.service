[Unit]
Description=WVC authenticated KAmod service heartbeat receiver
After=network.target wvc-sensor-firewall.service wvc-sensor-dhcp.service
Wants=wvc-sensor-firewall.service wvc-sensor-dhcp.service

[Service]
Type=simple
User=wentylacja
Group=wentylacja
WorkingDirectory=/home/wentylacja/workshop-ventilation-controller
Environment=PYTHONPATH=/home/wentylacja/workshop-ventilation-controller/src
Environment=PYTHONUNBUFFERED=1
RuntimeDirectory=wvc-service-heartbeat
RuntimeDirectoryMode=0750
StateDirectory=wvc-service-heartbeat
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 -m ventilation_core.service_heartbeat --bind 10.55.0.1 --port 45551 --keys /etc/wvc-service-heartbeat/keys.json --runtime-dir /run/wvc-service-heartbeat --state-dir /var/lib/wvc-service-heartbeat --stale-after 35 --log-level INFO
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
