[Unit]
Description=Workshop Ventilation CM5 Weather Provider
After=network-online.target local-fs.target
Wants=network-online.target
RequiresMountsFor=/srv/wvc-data

[Service]
Type=simple
User=wentylacja
Group=wentylacja
WorkingDirectory=/home/wentylacja/workshop-ventilation-controller
Environment=PYTHONPATH=/home/wentylacja/workshop-ventilation-controller/src
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/etc/default/wvc-weather
ExecStartPre=/usr/bin/mountpoint -q /srv/wvc-data
ExecStart=/usr/bin/python3 -m ventilation_core.weather.main --cache /srv/wvc-data/workshop-ventilation/weather.json --poll-interval 3600 --http-timeout 5 --log-level INFO
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
KillSignal=SIGTERM
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/wvc-data/workshop-ventilation
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0027

[Install]
WantedBy=multi-user.target
