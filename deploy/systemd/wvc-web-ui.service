[Unit]
Description=Workshop Ventilation Web UI
After=network-online.target ventilation-core.service
Wants=network-online.target

[Service]
Type=simple
User=wentylacja
Group=wentylacja
WorkingDirectory=/home/wentylacja/workshop-ventilation-controller
Environment=PYTHONPATH=/home/wentylacja/workshop-ventilation-controller/src
EnvironmentFile=-/etc/default/wvc-web-ui
ExecStart=/usr/bin/python3 -m ventilation_core.web.main
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# SQLite WAL readers need access to the database directory for shared-memory bookkeeping.
# Application code opens telemetry.sqlite3 read-only; keep the writable sandbox exception scoped
# to the workshop-ventilation state directory instead of weakening ProtectSystem globally.
ReadWritePaths=/var/lib/workshop-ventilation
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# SERVICE dashboard reads routing/address state through the read-only `ip -j` interface.
# `ip` uses rtnetlink, so AF_NETLINK must be allowed alongside the existing socket families.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0027

[Install]
WantedBy=multi-user.target
