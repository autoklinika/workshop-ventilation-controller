[Unit]
Description=Workshop Ventilation Web UI
After=network-online.target ventilation-core.service wvc-host-power.service
Wants=network-online.target wvc-host-power.service

[Service]
Type=simple
User=wentylacja
Group=wentylacja
WorkingDirectory=/home/wentylacja/workshop-ventilation-controller
Environment=PYTHONPATH=/home/wentylacja/workshop-ventilation-controller/src
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=WVC_WEB_TELEMETRY_DATABASE=/srv/wvc-data/workshop-ventilation/telemetry.sqlite3
Environment=WVC_WEB_ALERT_DATABASE=/srv/wvc-data/workshop-ventilation/alerts.sqlite3
Environment=WVC_WEB_WEATHER_SNAPSHOT=/srv/wvc-data/workshop-ventilation/weather.json
Environment=WVC_WEB_AI_ADVISORY_CACHE=/srv/wvc-data/workshop-ventilation/ai-advisory.json
EnvironmentFile=-/etc/default/wvc-web-ui
ExecStart=/usr/bin/python3 -m ventilation_core.web.main
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# SQLite WAL readers need write access to the NVMe database directory for shared-memory bookkeeping.
# Prefix '-' keeps live GUI/control available when the optional history data tier is absent.
ReadWritePaths=-/srv/wvc-data/workshop-ventilation
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# SERVICE dashboard reads routing/address state through the read-only `ip -j` interface.
# `ip` uses rtnetlink, so AF_NETLINK must be allowed alongside the existing socket families.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0027

[Install]
WantedBy=multi-user.target
